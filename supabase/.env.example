# Read by the Supabase CLI (config.toml env() values) and by the Makefile.

# Domain of the Clerk development instance whose session tokens local
# Supabase should trust, e.g. `your-app-12.clerk.accounts.dev`
# (https://clerk.com/setup/supabase). Required for `supabase start`.
CLERK_DOMAIN=

# Production project credentials for `make push-production`. Generate with
# `cd ../terraform && terraform output -json supabase_env`. Not needed locally.
PROD_PROJECT_REF=
PROD_DB_PASSWORD=
