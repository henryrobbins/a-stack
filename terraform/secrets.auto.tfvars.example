# Copy to secrets.auto.tfvars (git-ignored); Terraform loads it automatically.

# Vercel → Account settings → Tokens. Scope: the team that owns the project.
vercel_api_token = ""

# Supabase → Account → Access tokens (sbp_...). Full account access.
supabase_access_token = ""

# Postgres password for the new Supabase project (choose a strong value).
supabase_database_password = ""

# Clerk development instance → API keys (sk_test_...).
clerk_secret_key = ""

# Clerk → Webhooks → endpoint https://<project>.vercel.app/api/webhooks/clerk with events
# user.created and user.deleted → Signing secret (whsec_...).
clerk_webhook_signing_secret = ""

# Anthropic console → API keys (sk-ant-...).
anthropic_api_key = ""

# Shared with the Modal secret (agent/.env). Generate: openssl rand -hex 32
agent_trigger_secret = ""
