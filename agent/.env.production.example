# Uploaded to Modal as the `a-stack-agent` secret by `make secrets`. Generate
# every value from Terraform rather than filling this in by hand; from
# terraform/:
#   terraform output -json agent_env | jq -r 'to_entries[] | "\(.key)=\(.value)"' > ../agent/.env.production
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
AGENT_TRIGGER_SECRET=
