# Read by `make dev`, and uploaded to Modal as the `a-stack-agent` secret by
# `make secrets`.

# The worker acts on behalf of runs, not user sessions, so it uses the secret
# key. For `make dev`, use `cd ../supabase && supabase status -o env`. A
# Modal container cannot reach 127.0.0.1, so `make serve` needs a cloud project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=

# Shared with web/.env (AGENT_TRIGGER_SECRET). Generate: openssl rand -hex 32
AGENT_TRIGGER_SECRET=
