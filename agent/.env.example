# Read by `make dev`, which runs agents in-process against local Supabase.

# The worker acts on behalf of runs, not user sessions, so it uses the secret
# key. Local Supabase: `cd ../supabase && supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=

# Shared with web/.env (AGENT_TRIGGER_SECRET). Generate: openssl rand -hex 32
AGENT_TRIGGER_SECRET=
