# Playwright environment. The dev servers read web/.env and api/.env.

# Clerk development instance (same as web/.env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# A user that exists in the Clerk development instance; tests sign in as it.
E2E_TEST_EMAIL=

# Local Supabase: `cd ../supabase && supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
