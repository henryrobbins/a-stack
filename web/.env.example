# Clerk development instance (Clerk dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook signing secret (Clerk dashboard → Webhooks → endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=

# Local Supabase: `cd ../supabase && supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Agent trigger: http://localhost:8100 for `cd ../agent && make dev`, or the
# `trigger` URL printed by `make serve`. Same shared secret as agent/.env.
AGENT_TRIGGER_URL=
AGENT_TRIGGER_SECRET=
