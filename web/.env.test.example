# Vitest environment. Fill from `cd ../supabase && supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Any Svix-style secret; tests sign their own webhook requests with it.
# Generate: node -e "console.log('whsec_'+require('crypto').randomBytes(32).toString('base64'))"
CLERK_WEBHOOK_SIGNING_SECRET=
